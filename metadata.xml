<?xml version="1.0" encoding="UTF-8"?>
<Entities>
  <ExtensionPackages>
    <ExtensionPackage name="FTPHandler"
                      description="FTP/FTPS/SFTP file transfer extension for ThingWorx"
                      vendor="Derrick Swint"
                      packageVersion="1.1.3"
                      minimumThingWorxVersion="8.0.0">
      <JarResources>
        <FileResource type="JAR" file="FTPHandler-1.1.3.jar"/>
        <FileResource type="JAR" file="commons-net-3.9.0.jar"/>
        <FileResource type="JAR" file="jsch-0.1.55.jar"/>
      </JarResources>
    </ExtensionPackage>
  </ExtensionPackages>

  <ThingPackages>
    <ThingPackage name="FTPConnectionThing"
                  description="FTP/FTPS/SFTP connection configuration and file transfer services"
                  className="com.ptc.ftpwidget.FTPConnectionThing"
                  aspect.isSystemObject="false"
                  aspect.isCreatable="true"/>
  </ThingPackages>

  <ThingTemplates>
    <ThingTemplate name="FTPConnectionTemplate"
                   description="FTP/FTPS/SFTP connection configuration and file transfer services"
                   thingPackage="FTPConnectionThing"
                   aspect.isSystemObject="false">
    </ThingTemplate>
  </ThingTemplates>

</Entities>
